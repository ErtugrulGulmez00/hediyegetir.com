# --- Veritabanı ---
# Yerelde docker-compose ile ikisi aynı olabilir.
# Neon'da: DATABASE_URL = havuzlu (-pooler) adres, DIRECT_URL = doğrudan adres.
DATABASE_URL="postgresql://hediye:hediye@localhost:5433/hediyegetir"
DIRECT_URL="postgresql://hediye:hediye@localhost:5433/hediyegetir"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Admin ayarlarında numara girilmemişse kullanılır. Ülke koduyla, + ve boşluk olmadan: 905xxxxxxxxx
WHATSAPP_NUMBER_FALLBACK=""

# --- Admin ---
ADMIN_USERNAME="admin"
# `npm run hash-password -- "sifren"` çıktısı. .env içinde $ işaretlerini \$ ile kaçır.
ADMIN_PASSWORD_HASH=""
# En az 32 karakterlik rastgele dize (oturum çerezi imzası)
AUTH_SECRET=""

# --- Ziyaret istatistikleri ---
# Ziyaretçi çerezini hash'lerken kullanılan tuz (rastgele dize)
VISITOR_SALT=""

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=""

# --- ikas içe aktarma ---
IKAS_BASE_URL="https://hediyeyolla.ikas.shop"
