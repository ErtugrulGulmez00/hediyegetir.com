// hediyegetir.com veri modeli
// Para birimleri kuruş cinsinden tamsayı olarak tutulur (₺12,50 = 1250).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  KADIN
  ERKEK
  UNISEX
}

// Ürün sayfasında fotoğrafların dizilişi
enum GalleryLayout {
  TEK // tek büyük fotoğraf, kaydırmalı
  IKILI // iki sütunlu ızgara
  UCLU // bir büyük + iki küçük, sonrası üç sütun
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  description         String         @default("")
  priceKurus          Int
  compareAtPriceKurus Int?
  // null = sipariş üzerine üretilir (stok takibi yok)
  stock               Int?
  isActive            Boolean        @default(true)
  isFeatured          Boolean        @default(false)
  categoryId          String?
  category            Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  galleryLayout       GalleryLayout  @default(TEK)
  // Ürün sayfasındaki mürekkep damgaları (en fazla 3); boş liste = damga yok. Damgalı ürün el yapımı sayılır
  stamps              String[]       @default([])

  // Hediş etiketleri
  recipients    String[] @default([])
  gender        Gender   @default(UNISEX)
  hobbies       String[] @default([])
  hedisReviewed Boolean  @default(false)
  // Hangi özel günler için uygun (config.ts OCCASIONS anahtarları)
  occasions     String[] @default([])
  // Serbest anahtar kelimeler (küçük harf): Hediş eşleştirmesi ve arama için
  tags          String[] @default([])
  // Kısa ürün özellikleri (madde madde); ürün sayfasında gösterilir
  features      String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)
  // Vercel Blob'da mı duruyor (silinirken blob da silinir)
  isBlob    Boolean @default(false)

  @@index([productId, sortOrder])
}

// Tek satırlık site ayarları (id her zaman 1)
model Settings {
  id               Int      @id @default(1)
  whatsappNumber   String   @default("")
  whatsappGreeting String   @default("Merhaba! hediyegetir üzerinden şu ürünlerle ilgileniyorum:")
  instagramUrl     String   @default("")
  // Ürün fotoğrafından öneri üreten model (görüntü destekli). Adında "/" varsa OpenRouter, yoksa OpenAI.
  aiModel          String   @default("gpt-6-luna")
  updatedAt        DateTime @updatedAt
}

model DailyStat {
  // Europe/Istanbul gününe göre YYYY-MM-DD
  date           String @id
  visits         Int    @default(0)
  uniqueVisitors Int    @default(0)
  pageViews      Int    @default(0)
}

model VisitorDay {
  date        String
  visitorHash String

  @@id([date, visitorHash])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // istemci IP'sinin hash'i
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Herkese açık yapay zeka uç noktaları için istek sınırı (IP hash'i, IP'nin kendisi tutulmaz)
model AiRequest {
  id        String   @id @default(cuid())
  key       String
  kind      String // ör. "hedis"
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
  @@index([kind, createdAt])
}
